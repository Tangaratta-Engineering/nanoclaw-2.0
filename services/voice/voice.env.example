# Copy to voice.env (gitignored). The bot token is read from the repo's .env (DISCORD_BOT_TOKEN)
# unless VOICE_BOT_TOKEN is set.
VOICE_GUILD_ID=
VOICE_CHANNEL_ID=
VOICE_USER_ID=
VOICE_AGENT_NAME=Tiff
VOICE_VOICE_ID=en_US-hfc_female-medium
# OneCLI agent identifier (injects the Groq key) and the agent group's image
VOICE_ONECLI_AGENT=
VOICE_AGENT_IMAGE=
# The DM messaging group the call talks to (ncl messaging-groups list), e.g. discord:@me:<channel id>
VOICE_DM_PLATFORM_ID=
# VOICE_INSTANCE=timmy   # for the second bot
# Several agents in one channel: the default agent lists the others' names, a named agent lists its own.
# VOICE_OTHER_NAMES=timmy,timmie,tim,jimmy,timothy      (default agent: ignore utterances addressed to these)
# VOICE_WAKE_NAMES=timmy,timmie,tim,jimmy,timothy       (named agent: answer only when addressed by one of these)
# VOICE_TOKEN_VAR=DISCORD_TIMMY_BOT_TOKEN  (which variable in .env holds this agent's bot token)
