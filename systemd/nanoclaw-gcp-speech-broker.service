[Unit]
Description=NanoClaw Google Speech token broker (vault-held service account -> Speech-to-Text v2 / Chirp)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/nanoclaw-2.0/services/gcp-speech-broker
Environment=HOME=%h
ExecStart=%h/.nvm/versions/node/v22.22.3/bin/node server.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
