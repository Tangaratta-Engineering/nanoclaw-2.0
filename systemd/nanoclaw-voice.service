[Unit]
Description=NanoClaw live voice channel (Tiff)
After=nanoclaw.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/nanoclaw-2.0/services/voice
EnvironmentFile=%h/projects/nanoclaw-2.0/.env
EnvironmentFile=%h/projects/nanoclaw-2.0/services/voice/voice.env
Environment=HOME=%h
Environment=PATH=/home/george/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v22.22.3/bin/node --experimental-strip-types src/index.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
